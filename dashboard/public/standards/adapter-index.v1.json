        {
          "name": "Sigstore bundle",
          "specification": "https://github.com/sigstore/protobuf-specs/blob/main/protos/sigstore_bundle.proto"
        }
      ],
      "repositoryReferences": [
        "docs/specs/adapters/sigstore-in-toto-v1.md",
