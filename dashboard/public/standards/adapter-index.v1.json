      "repositoryReferences": [
        "docs/standards/OPEN_CRYPTO_SDK.md"
      ],
      "capabilities": [],
      "trust": {
        "networkInput": "none",
        "outputAuthentication": "none",
        "liveDeploymentVerified": false
      },
      "boundaries": [
