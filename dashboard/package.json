{
  "name": "@zerone/mainnet-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lab": "vite --config vite.power-lab.config.mjs --open /power-lab.html",
    "generate:lab-fixture": "node scripts/generate-power-lab-fixture.mjs",
    "check:lab-fixture": "node scripts/generate-power-lab-fixture.mjs --check",
    "check:lab-excluded": "node scripts/assert-power-lab-excluded.mjs dist",
    "check:receipts": "node --test ../tools/constructive-receipts/validate.test.mjs",
    "build": "npm run check && vite build && npm run check:lab-excluded && npm run build:functions",
    "build:functions": "wrangler pages functions build functions --outdir .wrangler/functions-build",
    "check": "npm run check:index && npm run check:tree && npm run check:receipts && npm run check:lab-fixture && npm test && tsc --noEmit && tsc --project tsconfig.functions.json --noEmit",
    "check:index": "node scripts/validate-adapter-index.mjs public/standards/adapter-index.v1.json && node --test scripts/adapter-index.test.mjs",
    "check:tree": "node scripts/validate-constructive-intelligence-tree.mjs public/standards/constructive-intelligence-tree.v1.json && node --test scripts/constructive-intelligence-tree.test.mjs",
    "test": "NODE_OPTIONS=--preserve-symlinks tsx --test tests/*.test.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@cosmjs/amino": "0.39.0",
    "@cosmjs/crypto": "0.39.0",
    "@cosmjs/encoding": "0.39.0",
    "@cosmjs/proto-signing": "0.39.0",
    "@cosmjs/stargate": "0.39.0",
    "@zerone-chain/sdk": "file:../sdk/typescript",
    "cosmjs-types": "0.11.0"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vite": "8.1.4",
    "wrangler": "4.115.0"
  }
}
