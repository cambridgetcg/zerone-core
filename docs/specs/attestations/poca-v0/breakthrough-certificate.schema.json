{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cambridgetcg/zerone-core/blob/main/docs/specs/attestations/poca-v0/breakthrough-certificate.schema.json",
  "title": "Zerone BreakthroughCertificate v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "evaluator_version",
    "assurance",
    "claim_id",
    "profile",
    "evidence_bundle_digest",
    "subject",
    "node_results",
    "attained_tier",
    "crown_status",
    "unresolved_challenge_digests",
    "reward",
    "notices",
    "limitations"
  ],
  "properties": {
    "schema": {
      "const": "zerone.breakthrough-certificate/v0"
    },
    "evaluator_version": {
      "const": "poca-shadow/v0"
    },
    "assurance": {
      "const": "UNVERIFIED_SHADOW_PROJECTION"
    },
    "claim_id": {
      "$ref": "#/$defs/digest"
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "profile_version",
        "digest"
      ],
      "properties": {
        "profile_id": {
          "$ref": "#/$defs/id"
        },
        "profile_version": {
          "$ref": "#/$defs/id"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "evidence_bundle_digest": {
      "$ref": "#/$defs/digest"
    },
    "subject": {
      "$ref": "#/$defs/artifact"
    },
    "node_results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/node_result"
      }
    },
    "attained_tier": {
      "$ref": "#/$defs/tier"
    },
    "crown_status": {
      "$ref": "#/$defs/status"
    },
    "unresolved_challenge_digests": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/digest"
      }
    },
    "reward": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "economic_effect",
        "amount_uzrn",
        "reason"
      ],
      "properties": {
        "economic_effect": {
          "const": "NONE"
        },
        "amount_uzrn": {
          "const": "0"
        },
        "reason": {
          "const": "shadow-profile-v0"
        }
      }
    },
    "notices": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/detail"
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/detail"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:@/-]{0,127}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "https": {
      "type": "string",
      "maxLength": 2048,
      "pattern": "^https://[^?#]+$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "media_type",
        "digest"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "media_type": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9!#$&^_.+-]+/[A-Za-z0-9!#$&^_.+-]+$"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "source_uri": {
          "$ref": "#/$defs/https"
        }
      }
    },
    "stage": {
      "enum": [
        "GROUND",
        "CAPABILITY",
        "INDUSTRIAL",
        "RECURSIVE",
        "CROWN"
      ]
    },
    "tier": {
      "enum": [
        "NONE",
        "E0_ASSERTED",
        "E1_REPRODUCED",
        "E2_CONFORMANT",
        "E3_CAUSAL",
        "E4_TRANSFERRED",
        "E5_REUSED"
      ]
    },
    "status": {
      "enum": [
        "DECLARED_PASS",
        "BLOCKED",
        "FAILED"
      ]
    },
    "refusal_code": {
      "enum": [
        "PREREQUISITE_NOT_MET",
        "EVIDENCE_MISSING",
        "INSUFFICIENT_INDEPENDENCE",
        "EVIDENCE_FAILED",
        "HARD_GUARDRAIL_FAILED",
        "CHALLENGE_OPEN",
        "PROFILE_NOT_RATIFIED",
        "PROFILE_SUPERSEDED"
      ]
    },
    "detail": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "requirement_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_id",
        "status",
        "accepted_evidence_ids",
        "control_cluster_claims",
        "refusal_codes",
        "refusal_details"
      ],
      "properties": {
        "requirement_id": {
          "$ref": "#/$defs/id"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "accepted_evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "control_cluster_claims": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "refusal_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/refusal_code"
          }
        },
        "refusal_details": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/detail"
          }
        }
      }
    },
    "node_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "stage",
        "tier",
        "status",
        "prerequisites",
        "requirement_results",
        "accepted_evidence_ids",
        "control_cluster_claims",
        "refusal_codes",
        "refusal_details"
      ],
      "properties": {
        "node_id": {
          "$ref": "#/$defs/id"
        },
        "stage": {
          "$ref": "#/$defs/stage"
        },
        "tier": {
          "$ref": "#/$defs/tier"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "prerequisites": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "requirement_results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/requirement_result"
          }
        },
        "accepted_evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "control_cluster_claims": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "refusal_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/refusal_code"
          }
        },
        "refusal_details": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/detail"
          }
        }
      }
    }
  }
}
