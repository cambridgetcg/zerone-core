{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cambridgetcg/zerone-core/blob/main/docs/specs/attestations/poca-v0/standard-profile.schema.json",
  "title": "Zerone StandardProfile v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "profile_id",
    "profile_version",
    "title",
    "status",
    "assurance_mode",
    "standards",
    "requirements",
    "nodes",
    "crown_node_id",
    "challenge_policy",
    "economics"
  ],
  "properties": {
    "schema": {
      "const": "zerone.standard-profile/v0"
    },
    "profile_id": {
      "$ref": "#/$defs/id"
    },
    "profile_version": {
      "$ref": "#/$defs/id"
    },
    "title": {
      "$ref": "#/$defs/title"
    },
    "status": {
      "enum": [
        "DRAFT",
        "DECLARED_RATIFIED",
        "SUPERSEDED"
      ]
    },
    "assurance_mode": {
      "const": "SHADOW_ONLY"
    },
    "standards": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/standard"
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/requirement"
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "crown_node_id": {
      "$ref": "#/$defs/id"
    },
    "challenge_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unresolved_challenge_blocks_crown"
      ],
      "properties": {
        "unresolved_challenge_blocks_crown": {
          "type": "boolean"
        }
      }
    },
    "economics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "amount_uzrn"
      ],
      "properties": {
        "mode": {
          "const": "NONE"
        },
        "amount_uzrn": {
          "const": "0"
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:@/-]{0,127}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "https": {
      "type": "string",
      "maxLength": 2048,
      "pattern": "^https://[^?#]+$"
    },
    "standard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uri",
        "version",
        "status",
        "target"
      ],
      "properties": {
        "uri": {
          "$ref": "#/$defs/https"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "status": {
          "enum": [
            "DRAFT",
            "STABLE",
            "APPROVED",
            "SUPERSEDED"
          ]
        },
        "target": {
          "$ref": "#/$defs/title"
        }
      }
    },
    "kind": {
      "enum": [
        "PROBLEM_CONTRACT",
        "SIGNED_PROVENANCE",
        "CONFORMANCE_RESULT",
        "CONSUMER_VERIFICATION",
        "INDEPENDENT_REBUILD",
        "CAUSAL_EVALUATION",
        "INTEROPERABILITY_RESULT",
        "PRODUCTION_SLO",
        "ROLLBACK_DRILL",
        "SECURITY_ASSESSMENT",
        "INDEPENDENT_ADOPTION",
        "ZERONE_RECURSIVE_VALUE",
        "ZERONE_CHAIN_RECORD"
      ]
    },
    "verification_rule": {
      "enum": [
        "FROZEN_BASELINE_AND_GUARDRAILS",
        "SIGSTORE_SIGNATURE_AND_SUBJECT",
        "SLSA_BUILD_V1_EXPECTATIONS",
        "ALL_TEST_CASES_PASS",
        "BYTE_IDENTICAL_SUBJECT",
        "CAUSAL_HOLDOUT_GAIN",
        "INTEROPERABILITY_SUITE_PASS",
        "SLO_AND_GUARDRAILS_PASS",
        "ROLLBACK_COMPLETED",
        "INDEPENDENT_ADOPTION_RECEIPT",
        "ZERONE_RECURSION_LINK",
        "CHAIN_RECORD_MATCHES"
      ]
    },
    "observer_role": {
      "enum": [
        "PRODUCER",
        "SPONSOR",
        "VERIFIER",
        "ADOPTER",
        "OPERATOR",
        "CHALLENGER"
      ]
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "verification_rule",
        "policy_digest",
        "observer_role",
        "min_count",
        "min_independent_control_clusters",
        "require_observer_independent_from_claimant",
        "hard_guardrail"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "$ref": "#/$defs/kind"
        },
        "verification_rule": {
          "$ref": "#/$defs/verification_rule"
        },
        "policy_digest": {
          "$ref": "#/$defs/digest"
        },
        "predicate_type": {
          "$ref": "#/$defs/https"
        },
        "observer_role": {
          "$ref": "#/$defs/observer_role"
        },
        "min_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "min_independent_control_clusters": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "require_observer_independent_from_claimant": {
          "type": "boolean"
        },
        "hard_guardrail": {
          "type": "boolean"
        }
      }
    },
    "stage": {
      "enum": [
        "GROUND",
        "CAPABILITY",
        "INDUSTRIAL",
        "RECURSIVE",
        "CROWN"
      ]
    },
    "tier": {
      "enum": [
        "E0_ASSERTED",
        "E1_REPRODUCED",
        "E2_CONFORMANT",
        "E3_CAUSAL",
        "E4_TRANSFERRED",
        "E5_REUSED"
      ]
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "stage",
        "tier",
        "title",
        "prerequisites",
        "requirement_ids"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "stage": {
          "$ref": "#/$defs/stage"
        },
        "tier": {
          "$ref": "#/$defs/tier"
        },
        "title": {
          "$ref": "#/$defs/title"
        },
        "prerequisites": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "requirement_ids": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
