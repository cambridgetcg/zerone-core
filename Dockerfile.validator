# RETIRED — intentionally not a validator image.
#
# The former file built moving source, installed cosmovisor@latest, permitted
# runtime binary downloads, and started whatever /root/.zeroned happened to
# contain. That is incompatible with Zerone's release-bound validator policy.
FROM debian:bookworm-slim

CMD ["/bin/sh", "-c", "echo 'REFUSED: Dockerfile.validator is retired; use a signed, release-bound network image.' >&2; exit 1"]
