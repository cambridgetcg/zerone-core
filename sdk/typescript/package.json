{
  "name": "@zerone-chain/sdk",
  "version": "0.1.0",
  "description": "Typed transaction codecs, interoperable identifiers, and offline provenance profiles for Zerone",
  "type": "module",
  "sideEffects": false,
  "license": "Apache-2.0",
  "packageManager": "npm@11.9.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cambridgetcg/zerone-core.git",
    "directory": "sdk/typescript"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./caip": {
      "types": "./dist/types/caip.d.ts",
      "import": "./dist/caip.js"
    },
    "./liquidity": {
      "types": "./dist/types/liquidity.d.ts",
      "import": "./dist/liquidity.js"
    },
    "./cid": {
      "types": "./dist/types/cid.d.ts",
      "import": "./dist/cid.js"
    },
    "./feegrant": {
      "types": "./dist/types/feegrant.d.ts",
      "import": "./dist/feegrant.js"
    },
    "./messages": {
      "types": "./dist/types/messages.d.ts",
      "import": "./dist/messages.js"
    },
    "./provenance": {
      "types": "./dist/types/provenance.d.ts",
      "import": "./dist/provenance.js"
    },
    "./registry": {
      "types": "./dist/types/registry.d.ts",
      "import": "./dist/registry.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs && tsc --project tsconfig.build.json && node scripts/fix-declarations.mjs && npm run check:consumer",
    "check": "npm run check:generated && npm run check:registry && npm run typecheck && npm test",
    "check:consumer": "tsc --ignoreConfig --noEmit --target ES2022 --module NodeNext --moduleResolution NodeNext --strict --skipLibCheck false tests/consumer-nodenext.mts",
    "check:generated": "node scripts/check-generated.mjs",
    "check:publish": "node scripts/check-publish.mjs",
    "check:registry": "node scripts/check-registry.mjs",
    "generate": "node scripts/generate.mjs",
    "prepack": "npm run check && npm run build",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.10.2",
    "@cosmjs/encoding": "0.39.0",
    "@noble/hashes": "2.2.0",
    "cosmjs-types": "0.11.0",
    "multiformats": "14.0.5",
    "protobufjs": "7.6.5"
  },
  "peerDependencies": {
    "@cosmjs/proto-signing": "0.39.0"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "minimatch@5.1.0": "5.1.8",
    "tmp@0.0.33": "0.2.7"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.65.0",
    "@cosmjs/proto-signing": "0.39.0",
    "@cosmjs/stargate": "0.39.0",
    "@hyperweb/telescope": "2.2.4",
    "@types/node": "26.1.2",
    "esbuild": "0.28.1",
    "tsx": "4.23.1",
    "typescript": "7.0.2"
  }
}
